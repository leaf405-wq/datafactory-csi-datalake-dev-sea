<view class="pad">
  <chrome active="{{active}}" headline="{{headline}}" roles="{{roles}}" pages="{{pages}}" show-filter="{{false}}" show-months="{{false}}" photo-url="{{photoUrl}}" photo-name="{{photoName}}" photo-meta="{{photoMeta}}" bind:role="onRole" bind:nav="onNav" bind:base="onBase" />
  <view class="h2">5.3 租金与提点计算引擎</view>
  <view class="lede">四种商场租金模型用同一套月结引擎试算。下面这个计算器只加附加物业费，不含增值税、推广费和水电费。月结泳道仍按合同计税。试算不写入 Access。</view>
  <view wx:if="{{error}}" class="err" bindtap="onRetry">{{error}}</view>
  <view class="panel">
    <view class="tr"><view class="th td col-store">模型</view><view class="th td col-store">计算公式</view><view class="th td col-store">应用场景</view></view>
    <view class="tr" wx:for="{{matrix}}" wx:key="id">
      <view class="td col-store">{{item.cells[0]}}</view>
      <view class="td col-store">{{item.cells[1]}}</view>
      <view class="td col-store">{{item.cells[2]}}</view>
    </view>
  </view>
  <view class="panel">
    <view class="h2">交互演示：租金计算器</view>
    <view class="field">
      <text class="lab">租金模型</text>
      <picker mode="selector" range="{{models}}" range-key="label" value="{{modelIndex}}" bindchange="onModel">
        <view class="input">{{modelLabel}}</view>
      </picker>
    </view>
    <view class="field"><text class="lab">当月实际销售额（元）</text><view class="field-box"><input class="input" value="{{form.sales}}" data-key="sales" bindinput="setField" /></view></view>
    <view class="field"><text class="lab">合同固定租金（元/月）</text><view class="field-box"><input class="input" value="{{form.fixedRent}}" data-key="fixedRent" bindinput="setField" /></view></view>
    <view class="field"><text class="lab">商场扣点比例（%）</text><view class="field-box"><input class="input" value="{{form.rate}}" data-key="rate" bindinput="setField" /></view></view>
    <view class="field"><text class="lab">附加物业费（元/月）</text><view class="field-box"><input class="input" value="{{form.propertyFee}}" data-key="propertyFee" bindinput="setField" /></view></view>
    <block wx:if="{{form.model === 'BASE_PLUS_OVERAGE'}}">
      <view class="field"><text class="lab">保底销售额（元）</text><view class="field-box"><input class="input" value="{{form.minSales}}" data-key="minSales" bindinput="setField" /></view></view>
      <view class="field"><text class="lab">超额扣点（%）</text><view class="field-box"><input class="input" value="{{form.overageRate}}" data-key="overageRate" bindinput="setField" /></view></view>
    </block>
    <view wx:if="{{form.model === 'CAPPED'}}" class="field"><text class="lab">封顶金额（元）</text><view class="field-box"><input class="input" value="{{form.capAmount}}" data-key="capAmount" bindinput="setField" /></view></view>
    <block wx:if="{{form.model === 'TIERED'}}">
      <view class="field"><text class="lab">第一档上限（元）</text><view class="field-box"><input class="input" value="{{form.tier1}}" data-key="tier1" bindinput="setField" /></view></view>
      <view class="field"><text class="lab">第一档扣点（%）</text><view class="field-box"><input class="input" value="{{form.rate1}}" data-key="rate1" bindinput="setField" /></view></view>
      <view class="field"><text class="lab">第二档上限（元）</text><view class="field-box"><input class="input" value="{{form.tier2}}" data-key="tier2" bindinput="setField" /></view></view>
      <view class="field"><text class="lab">第二档扣点（%）</text><view class="field-box"><input class="input" value="{{form.rate2}}" data-key="rate2" bindinput="setField" /></view></view>
      <view class="field"><text class="lab">以上扣点（%）</text><view class="field-box"><input class="input" value="{{form.rate3}}" data-key="rate3" bindinput="setField" /></view></view>
    </block>
    <view class="meta">填 18 表示 18%。这个演示的应付 = 模型租金 + 物业费。</view>
    <button class="btn" disabled="{{busy}}" bindtap="calc">计算当月应付租金</button>
    <view wx:if="{{result}}">
      <view class="num">{{result.payableText}}</view>
      <view class="meta">当月应付租金（元）</view>
      <view>{{result.formula}}</view>
      <view class="meta">{{result.detail}}</view>
    </view>
  </view>
</view>
