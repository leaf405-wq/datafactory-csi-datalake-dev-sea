page {
  background: #f4efe8;
  color: #241910;
  font-size: 28rpx;
  line-height: 1.45;
}
.pad { padding: 24rpx 24rpx calc(48rpx + env(safe-area-inset-bottom)); max-width: 100%; box-sizing: border-box; }
.h2 { font-size: 40rpx; font-weight: 600; }
.lede, .meta { color: #6f6258; font-size: 24rpx; }
.lede { margin: 12rpx 0 20rpx; }
.kpis { display: flex; flex-wrap: wrap; gap: 16rpx; margin: 12rpx 0 20rpx; }
.kpi { min-width: 42%; }
.kpi .num { display: block; font-size: 36rpx; font-weight: 600; }
.panel, .card {
  background: #fffdf9;
  border: 1rpx solid #e4d8cc;
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
}
.card .name { font-size: 32rpx; font-weight: 600; }
.card.closed { background: #eceae8; border-color: #d9d4cf; color: #8d8680; }
.card.closed .tag,
.card.closed .link,
.card.closed .name,
.card.closed .meta,
.card.closed .done,
.card.closed .alert { color: #8d8680; background: transparent; }
.link { color: #8c3f1c; }
.done { color: #1d6b45; font-weight: 700; }
.alert { color: #9d2c2c; font-weight: 700; }
.row, .queue { display: flex; flex-wrap: wrap; gap: 12rpx; align-items: center; margin: 12rpx 0; max-width: 100%; }
button { margin: 0; padding: 0; background: transparent; line-height: inherit; }
button::after { border: none; }
.btn, .ghost {
  border-radius: 999rpx;
  padding: 12rpx 22rpx;
  font-size: 26rpx;
  line-height: 1.4;
}
.btn { display: block; width: 100%; box-sizing: border-box; background: #241910; color: #f7f1ea; text-align: center; }
.row .btn, .row .ghost { width: auto; flex: 1 1 42%; }
.ghost { background: transparent; color: #241910; border: 1rpx solid #e4d8cc; }
.ghost.on, .chip.on { background: #241910; color: #f7f1ea; border-color: #241910; }
.chip { border: 1rpx solid #e4d8cc; border-radius: 999rpx; padding: 8rpx 16rpx; font-size: 24rpx; background: #fffdf9; }
.field { margin: 12rpx 0; width: 100%; }
.field .lab { display: block; color: #6f6258; font-size: 24rpx; margin-bottom: 6rpx; }
.field-box {
  display: flex;
  align-items: center;
  width: 100%;
  box-sizing: border-box;
  background: #fff;
  border: 1rpx solid #e4d8cc;
  border-radius: 12rpx;
  min-height: 80rpx;
  padding: 0 20rpx;
}
.field-box .input {
  flex: 1;
  width: 100%;
  min-width: 0;
  height: 80rpx;
  min-height: 80rpx;
  line-height: 80rpx;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 0;
  background: transparent;
  font-size: 30rpx;
  color: #241910;
}
.input, .area, picker .picker {
  display: block;
  width: 100%;
  box-sizing: border-box;
  background: #fff;
  border: 1rpx solid #e4d8cc;
  border-radius: 12rpx;
  padding: 0 20rpx;
  min-height: 80rpx;
  line-height: 80rpx;
  font-size: 30rpx;
  color: #241910;
}
.area { min-height: 180rpx; width: 100%; }
.err { color: #9d2c2c; margin: 12rpx 0; text-decoration: underline; }
.tag { display: inline-block; border-radius: 999rpx; padding: 2rpx 12rpx; font-size: 22rpx; background: #f3e4d8; }
.tag.red, .tag.severe { background: #f8e4e4; color: #9d2c2c; }
.tag.green { background: #e5f2eb; color: #1d6b45; }
.severe-head { color: #9d2c2c; font-weight: 700; }
.tag.orange { background: #ffe0c2; color: #c05612; }
.tag.yellow { background: #fff4cc; color: #8a5a00; }
.rail { display: flex; flex-wrap: wrap; gap: 6rpx; margin: 8rpx 0; }
.dot {
  width: 36rpx; height: 36rpx; border-radius: 50%;
  border: 2rpx solid #e4d8cc; text-align: center; line-height: 36rpx; font-size: 18rpx;
}
.scroll-x { width: 100%; }
.table { width: 100%; max-width: 100%; }
.tr { display: flex; flex-wrap: wrap; align-items: flex-start; border-bottom: 1rpx solid #e4d8cc; max-width: 100%; }
.td, .th {
  flex: 1 1 46%;
  width: auto;
  min-width: 0;
  max-width: 100%;
  padding: 12rpx 8rpx;
  font-size: 24rpx;
  line-height: 1.45;
  box-sizing: border-box;
  white-space: normal;
  word-break: break-word;
  overflow-wrap: anywhere;
}
.th { color: #6f6258; }
.col-store, .col-step { flex: 1 1 100%; width: auto; max-width: 100%; white-space: normal; }
.bar { height: 12rpx; background: #8c3f1c; border-radius: 999rpx; }
.bar-track { background: #f3e4d8; border-radius: 999rpx; height: 12rpx; margin: 8rpx 0; }
.photo { width: 100%; height: 280rpx; border-radius: 20rpx; background: #efe6dc; }
.step-li { display: flex; gap: 12rpx; padding: 8rpx 0; color: #6f6258; }
.step-li.now { color: #241910; font-weight: 600; }
.step-li.done { color: #1d6b45; }
